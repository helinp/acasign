APP_NAME=AcaSign
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://signature.exemple.lan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=signature
DB_USERNAME=signature
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Exemple Microsoft 365 en relais direct (sans compte) : MAIL_MAILER=smtp, MAIL_HOST=<domaine>.mail.protection.outlook.com,
# MAIL_PORT=25, MAIL_SCHEME=smtp (STARTTLS automatique), adresse d'expédition dans un domaine accepté du tenant.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI="${APP_URL}/auth/entra/callback"
# Domaines des comptes autorisés (séparés par des virgules), ex. ecole.be,pouvoir-organisateur.be
ENTRA_ALLOWED_DOMAINS=exemple.be
ENTRA_FORBIDDEN_USERNAME_FRAGMENT=.ELEVE
# Connexion sans Entra (comptes DevUserSeeder) — effectif seulement si APP_ENV=local
DEV_LOGIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=

# API d'intégration (logiciel RH, ERP…) — anciennement ACANET_*, toujours lues en secours
API_JWT_SECRET=
API_JWT_ISSUER=integration
API_WEBHOOK_URL=
API_WEBHOOK_SECRET=

TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PDF_SIGNING_CERTIFICATE=/run/secrets/pdf_signing_certificate
PDF_SIGNING_PRIVATE_KEY=/run/secrets/pdf_signing_private_key
PDF_SIGNING_PRIVATE_KEY_PASSWORD=
DOCUMENT_RETENTION_DAYS=90
SIGNATURE_HOST=signature.exemple.lan
# Traefik existant : nom de son réseau Docker et de ses entrypoints (ex. TRAEFIK_NETWORK=traefik)
TRAEFIK_NETWORK=proxy
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Signature eID (Web eID + DSS)
DSS_URL=http://dss:8080
DSS_SIGNATURE_LEVEL=PAdES_BASELINE_LT
TSA_URL=http://tsa.belgium.be/connect
DSS_TIMEOUT=60
